{
	"name": "ingot",
	"version": "0.5.17",
	"private": true,
	"description": "Fast, lightweight Minecraft launcher built with Tauri and React",
	"license": "GPL-3.0-only",
	"author": "0deans <https://github.com/0deans>",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"preview": "vite preview",
		"android:dev": "tauri android dev --host 127.0.0.1",
		"build": "typecheck && vite build",
		"test": "vitest run",
		"typecheck": "tsc --noEmit",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"check": "oxlint && oxfmt --check && tsc --noEmit",
		"fix": "oxlint --fix && oxfmt",
		"bump": "bumpp",
		"tauri": "tauri"
	},
	"dependencies": {
		"@tailwindcss/vite": "^4.3.5",
		"@tanstack/react-router": "^1.170.46",
		"@tauri-apps/api": "^2.12.4",
		"@tauri-apps/plugin-deep-link": "^2.6.3",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"tailwindcss": "^4.3.5",
		"taurpc": "^2.0.0",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@tanstack/react-router-devtools": "^1.167.3",
		"@tanstack/router-plugin": "^1.169.0",
		"@tauri-apps/cli": "^2.12.4",
		"@testing-library/dom": "^10.4.2",
		"@testing-library/react": "^16.3.3",
		"@testing-library/user-event": "^14.6.10",
		"@types/node": "^26.6.6",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.3.0",
		"bumpp": "^12.3.0",
		"jsdom": "^31.0.1",
		"oxfmt": "^0.78.0",
		"oxlint": "^1.93.0",
		"typescript": "~7.0.2",
		"vite": "^8.3.8",
		"vitest": "^5.1.0"
	},
	"packageManager": "pnpm@12.18.0"
}
