{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "ingot",
	"version": "0.2.1",
	"identifier": "ingot",
	"build": {
		"beforeDevCommand": "pnpm dev",
		"devUrl": "http://localhost:1420",
		"beforeBuildCommand": "pnpm build",
		"frontendDist": "../dist"
	},
	"app": {
		"windows": [
			{
				"label": "main",
				"title": "Ingot",
				"width": 1024,
				"height": 680,
				"minWidth": 800,
				"minHeight": 540,
				"resizable": true,
				"center": true,
				"decorations": false,
				"dragDropEnabled": false,
				"visible": false,
				"backgroundColor": "#09090b"
			}
		],
		"security": {
			"csp": null,
			"assetProtocol": {
				"enable": true,
				"scope": ["**"]
			}
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"createUpdaterArtifacts": true,
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		]
	},
	"plugins": {
		"updater": {
			"endpoints": ["https://github.com/0deans/ingot/releases/latest/download/latest.json"],
			"pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMwMEI0NjBGREZGOEM0QzQKUldURXhQamZEMFlMd0NNY3VCU2FVRlh5UFY0SmlDOUwzWXJmVDRQdU53Tytlc2ZlRDdzbk9CQUUK"
		}
	}
}
