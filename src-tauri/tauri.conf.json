{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "ingot",
	"version": "0.1.0",
	"identifier": "ingot",
	"build": {
		"beforeDevCommand": "pnpm dev",
		"devUrl": "http://localhost:1420",
		"beforeBuildCommand": "pnpm build",
		"frontendDist": "../dist"
	},
	"app": {
		"windows": [
			{
				"title": "Ingot",
				"width": 1024,
				"height": 680,
				"minWidth": 800,
				"minHeight": 540,
				"resizable": true,
				"center": true,
				"decorations": false,
				"dragDropEnabled": false
			}
		],
		"security": {
			"csp": null,
			"assetProtocol": {
				"enable": true,
				"scope": ["**"]
			}
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		]
	}
}
