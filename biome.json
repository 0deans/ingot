{
	"$schema": "https://biomejs.dev/schemas/2.5.13/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": [
			"**",
			"!**/dist",
			"!**/node_modules",
			"!**/src-tauri/target",
			"!**/public",
			"!**/routeTree.gen.ts",
			"!**/bindings.ts"
		]
	},
	"formatter": {
		"enabled": true,
		"formatWithErrors": false,
		"indentStyle": "tab",
		"indentWidth": 2,
		"lineWidth": 100
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"linter": {
		"enabled": true,
		"domains": {
			"react": "recommended"
		},
		"rules": {
			"preset": "recommended",
			"correctness": {
				"useHookAtTopLevel": "error",
				"useJsxKeyInIterable": "error",
				"noReactPropAssignments": "warn"
			},
			"style": {
				"useImportType": "warn",
				"useExportType": "warn",
				"useSelfClosingElements": "warn",
				"useFragmentSyntax": "warn"
			},
			"suspicious": {
				"noDuplicateJsxProps": "error",
				"noCommentText": "error",
				"noReactForwardRef": "warn"
			},
			"nursery": {
				"useSortedClasses": {
					"level": "warn",
					"fix": "safe",
					"options": {
						"attributes": ["classList"],
						"functions": ["cn", "cva", "clsx", "twMerge", "tw", "tw.*"]
					}
				},
				"useTailwindShorthandClasses": {
					"level": "warn",
					"fix": "safe"
				}
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double",
			"jsxQuoteStyle": "double",
			"semicolons": "asNeeded"
		},
		"jsxRuntime": "transparent"
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": {
					"level": "on",
					"options": {
						"sortBareImports": true,
						"groups": [":NODE:", ":PACKAGE:", ":ALIAS:", ":PATH:", ":STYLE:"]
					}
				}
			}
		}
	}
}
