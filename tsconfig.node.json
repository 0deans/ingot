{
	"compilerOptions": {
		"composite": true,
		"skipLibCheck": true,
		"module": "ESNext",
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"resolveJsonModule": true,
		"emitDeclarationOnly": true,
		"allowSyntheticDefaultImports": true
	},
	"include": ["vite.config.ts", "plugins/**/*.ts"]
}
